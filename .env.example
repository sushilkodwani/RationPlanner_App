# Copy to .env.local for local work, or set these as GitHub Actions *variables*
# (Settings -> Secrets and variables -> Actions -> Variables) for the deployed app.
# They are NOT secrets: the data repo is private and still needs the access key.
VITE_DATA_OWNER=your-github-username
VITE_DATA_REPO=ration-data
# Public half of the Web Push key pair (optional, only for notifications)
VITE_VAPID_PUBLIC_KEY=
